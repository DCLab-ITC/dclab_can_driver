  <version>2.1.0</version>
  <description>Messages of the DCLab CAN driver (DCLab boards, VESC, RoboMaster).</description>
  <maintainer email="soubungit@gmail.com">DCLab</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  
